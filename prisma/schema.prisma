generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmployeeRole {
  OWNER
  MANAGER
  EMPLOYEE
}

enum TireCondition {
  NEW
  USED
}

enum PaymentMethod {
  CASH
  CARD_EXTERNAL
  CASH_APP
  ZELLE
  OTHER
}

enum TransactionStatus {
  COMPLETED
  VOIDED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PrintJobStatus {
  PENDING
  PRINTING
  PRINTED
  FAILED
  RETRY_AVAILABLE
}

enum PrinterMode {
  EPSON_EPOS_NETWORK
  BROWSER_PRINT
  MOCK
}

enum AuditAction {
  EMPLOYEE_LOGIN
  COMPLETED_SALE
  FAILED_PRINT
  SUCCESSFUL_PRINT
  REPRINT
  REFUND
  VOID
  DISCOUNT
  TAX_OVERRIDE
  INVENTORY_ADJUSTMENT
  SETTINGS_CHANGE
  EMPLOYEE_CHANGE
  CASH_DRAWER_OPEN
}

model Employee {
  id             String       @id @default(cuid())
  name           String
  role           EmployeeRole @default(EMPLOYEE)
  pinHash        String
  active         Boolean      @default(true)
  failedAttempts Int          @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  logins         LoginActivity[]
  transactions   Transaction[]
  auditLogs      AuditLog[]    @relation("ActingEmployee")
  approvals      Approval[]    @relation("ApprovingEmployee")
}

model LoginActivity {
  id         String   @id @default(cuid())
  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id])
  success    Boolean
  ipHash     String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([employeeId, createdAt])
}

model Customer {
  id        String    @id @default(cuid())
  name      String?
  phone     String?
  email     String?
  address   String?
  notes     String?
  vehicles  Vehicle[]
  transactions Transaction[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([phone])
  @@index([name])
}

model Vehicle {
  id         String   @id @default(cuid())
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  year       String?
  make       String?
  model      String?
  trim       String?
  licensePlate String?
  vin        String?
  mileage    Int?
  notes      String?
  transactions Transaction[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([licensePlate])
}

model TireInventory {
  id              String        @id @default(cuid())
  tireSize        String
  brand           String
  model           String?
  condition       TireCondition
  quantityInStock Int           @default(0)
  costCents       Int           @default(0)
  sellingPriceCents Int         @default(0)
  dotCode         String?
  treadDepth      String?
  storageLocation String?
  supplier        String?
  notes           String?
  dateReceived    DateTime?
  lowStockThreshold Int         @default(2)
  active          Boolean       @default(true)
  adjustments     InventoryAdjustment[]
  saleLines       TransactionLine[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([tireSize])
  @@index([condition])
  @@index([active])
}

model Transaction {
  id                 String            @id @default(cuid())
  receiptNumber      String            @unique
  receiptYear        Int
  receiptSequence    Int
  idempotencyKey     String            @unique
  employeeId         String
  employee           Employee          @relation(fields: [employeeId], references: [id])
  customerId         String?
  customer           Customer?         @relation(fields: [customerId], references: [id])
  vehicleId          String?
  vehicle            Vehicle?          @relation(fields: [vehicleId], references: [id])
  status             TransactionStatus @default(COMPLETED)
  paymentMethod      PaymentMethod
  subtotalCents      Int
  discountCents      Int               @default(0)
  taxRateBasisPoints Int
  taxCents           Int
  totalCents         Int
  amountReceivedCents Int?
  changeDueCents     Int?
  notes              String?
  warrantyNotes      String?
  voidReason         String?
  refundReason       String?
  lines              TransactionLine[]
  printJobs          PrintJob[]
  refunds            Refund[]
  auditLogs          AuditLog[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([receiptYear, receiptSequence])
  @@index([createdAt])
  @@index([customerId])
  @@index([paymentMethod])
}

model TransactionLine {
  id              String       @id @default(cuid())
  transactionId   String
  transaction     Transaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  inventoryItemId String?
  inventoryItem   TireInventory? @relation(fields: [inventoryItemId], references: [id])
  label           String
  lineType        String
  quantity        Int
  unitCents       Int
  totalCents      Int
  createdAt       DateTime     @default(now())
}

model PrintJob {
  id            String         @id @default(cuid())
  transactionId String
  transaction   Transaction    @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  status        PrintJobStatus @default(PENDING)
  printerMode   PrinterMode
  attempts      Int            @default(0)
  lastError     String?
  printedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([transactionId, status])
}

model Refund {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  amountCents   Int
  reason        String
  approvedById  String?
  createdAt     DateTime    @default(now())
}

model InventoryAdjustment {
  id              String        @id @default(cuid())
  inventoryItemId String
  inventoryItem   TireInventory @relation(fields: [inventoryItemId], references: [id])
  deltaQuantity   Int
  beforeQuantity  Int
  afterQuantity   Int
  reason          String
  approvedById    String?
  createdAt       DateTime      @default(now())
}

model Approval {
  id             String   @id @default(cuid())
  approvedById   String
  approvedBy     Employee @relation("ApprovingEmployee", fields: [approvedById], references: [id])
  action         String
  reason         String?
  entityType     String
  entityId       String?
  createdAt      DateTime @default(now())
}

model QuickSaleButton {
  id          String   @id @default(cuid())
  label       String
  lineType    String
  unitCents   Int
  quantity    Int      @default(1)
  sortOrder   Int      @default(0)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ShopSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id               String      @id @default(cuid())
  actingEmployeeId String?
  actingEmployee   Employee?   @relation("ActingEmployee", fields: [actingEmployeeId], references: [id])
  action           AuditAction
  entityType       String
  entityId         String?
  beforeValue      Json?
  afterValue       Json?
  reason           String?
  transactionId    String?
  transaction      Transaction? @relation(fields: [transactionId], references: [id])
  createdAt        DateTime    @default(now())

  @@index([action, createdAt])
  @@index([actingEmployeeId, createdAt])
}
